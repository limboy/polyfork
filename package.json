{
  "name": "polyfork",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "build:dmg": "bash scripts/build-dmg.sh",
    "install:local": "bun run build && (osascript -e 'quit app \"Polyfork\"' || true) && rm -rf /Applications/Polyfork.app && ditto build/darwin-arm64/Polyfork.app /Applications/Polyfork.app && open /Applications/Polyfork.app",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "mygo-runtime": "^0.7.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/markdown-it": "^14.2.0",
    "@types/three": "^0.186.0",
    "mygo-cli": "^0.7.1",
    "typescript": "^7",
    "vite": "^8"
  }
}
